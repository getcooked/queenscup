<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash screen, using the same Queen's Cup logo
         as the launcher icon. -->
    <style name="Theme.QueensCup.Splash" parent="android:style/Theme.SplashScreen">
        <item name="android:windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/queens_cup_launcher</item>
        <item name="android:postSplashScreenTheme">@style/Theme.QueensCup</item>
    </style>
</resources>
